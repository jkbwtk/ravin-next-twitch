{
  "name": "ravin-next-twitch",
  "version": "0.0.1",
  "description": "Experimental twitch bot with dashboard",
  "main": "build/backend/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node --no-node-snapshot .",
    "dev": "cross-env DEV=true VITE_CJS_IGNORE_WARNING=true TS_NODE_PROJECT=./backend/tsconfig.json tsnd -r tsconfig-paths/register --no-node-snapshot ./backend/src/index.ts",
    "playground": "cross-env DEV=true VITE_CJS_IGNORE_WARNING=true TS_NODE_PROJECT=./backend/tsconfig.json tsnd -r tsconfig-paths/register --no-node-snapshot ./backend/src/playground.ts",
    "build": "vite build && cd ./backend && tsc -b",
    "build-backend": "cd ./backend && tsc -b",
    "build-frontend": "vite build",
    "watch": "cd backend && tsc -b --watch",
    "lint": "eslint --fix --ext .ts,.tsx ./frontend/src ./backend/src ./shared/src",
    "test": "vitest"
  },
  "author": "jkbwtk",
  "license": "ISC",
  "homepage": "https://github.com/jkbwtk/ravin-next-twitch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkbwtk/ravin-next-twitch.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "_moduleAliases": {
    "#types": "build/shared/types",
    "#lib": "build/backend/lib",
    "#database": "build/backend/database",
    "#bot": "build/backend/bot",
    "#server": "build/backend/server",
    "#routers": "build/backend/server/routers",
    "#jobs": "build/backend/jobs",
    "#schema": "build/shared/schema",
    "#shared": "build/shared/"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "@faker-js/faker": "^8.4.1",
    "@prisma/client": "^5.16.2",
    "@rollup/plugin-alias": "^5.1.0",
    "@solidjs/router": "^0.13.6",
    "@suid/icons-material": "^0.7.0",
    "@suid/material": "^0.16.0",
    "@suid/vite-plugin": "^0.2.0",
    "@types/passport": "^1.0.16",
    "@types/pg": "^8.11.6",
    "axios": "^1.7.2",
    "body-parser": "^1.20.2",
    "chalk": "^4.1.2",
    "chart.js": "^4.4.3",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.1",
    "cookies": "^0.9.1",
    "croner": "^8.1.0",
    "cross-env": "^7.0.3",
    "csv": "^6.3.9",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.32.0",
    "drizzle-zod": "^0.5.1",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "highlight.js": "^11.10.0",
    "ioredis": "^5.4.1",
    "isolated-vm": "^5.0.1",
    "module-alias": "^2.2.3",
    "on-finished": "^2.4.1",
    "on-headers": "^1.0.2",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.12.0",
    "prisma-json-types-generator": "^3.0.4",
    "qs": "^6.12.3",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.4.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "solid-js": "^1.8.18",
    "solid-transition-group": "^0.2.3",
    "tmi.js": "^1.8.5",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.5",
    "@types/express-session": "^1.18.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^20.14.10",
    "@types/on-finished": "^2.3.4",
    "@types/on-headers": "^1.0.3",
    "@types/passport-oauth2": "^1.4.17",
    "@types/qs": "^6.9.15",
    "@types/tmi.js": "^1.8.6",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "postcss-scss": "^4.0.9",
    "prisma": "^5.16.2",
    "sass": "^1.77.8",
    "ts-essentials": "^10.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^1.6.0",
    "vitest-mock-extended": "^1.3.1"
  }
}